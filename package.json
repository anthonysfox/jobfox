{
  "name": "jobfox",
  "version": "1.0.0",
  "private": true,
  "description": "Finds job postings, scores them against my resume, and drafts application material for human review.",
  "type": "module",
  "scripts": {
    "discover": "pnpm --filter @jobfox/pipeline discover",
    "matches": "pnpm --filter @jobfox/pipeline matches",
    "score": "pnpm --filter @jobfox/pipeline score",
    "label": "pnpm --filter @jobfox/pipeline label",
    "eval": "pnpm --filter @jobfox/pipeline eval",
    "web": "pnpm --filter @jobfox/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @jobfox/pipeline db:migrate",
    "db:studio": "pnpm --filter @jobfox/pipeline db:studio"
  },
  "author": "Anthony Fox",
  "license": "UNLICENSED",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
