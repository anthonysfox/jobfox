{
  "name": "@jobfox/pipeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Job discovery, filtering, and fit scoring.",
  "scripts": {
    "discover": "tsx --env-file=../../.env src/scripts/discover.ts",
    "matches": "tsx --env-file=../../.env src/scripts/matches.ts",
    "score": "tsx --env-file=../../.env src/scripts/score.ts",
    "label": "tsx --env-file=../../.env src/scripts/label.ts",
    "eval": "tsx --env-file=../../.env src/scripts/eval.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@prisma/client": "^6.19.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
